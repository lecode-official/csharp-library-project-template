{
    "name": "csharp-library-project-template",
    "version": "1.1.0",
    "private": true,
    "description": "A Copier template for C# library projects.",
    "type": "module",
    "scripts": {
        "format": "npx dprint fmt",
        "lint:dprint": "npx dprint check \"**/*\"",
        "lint:markdownlint": "npx markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\" \"!template/**\" \"!licenses/**\" \"!**/.venv/**\"",
        "lint:cspell": "npx cspell lint --no-progress \"**/*.md\" \"copier.yml\" \"scripts/**/*.py\" \".github/scripts/**/*.py\"",
        "lint": "run-s --continue-on-error lint:dprint lint:markdownlint lint:cspell"
    },
    "devDependencies": {
        "cspell": "10.5.2",
        "dprint": "0.65.0",
        "markdownlint-cli2": "0.24.2",
        "markdownlint-rule-relative-links": "5.1.4",
        "npm-run-all2": "9.1.0"
    },
    "packageManager": "npm@11.21.3",
    "engines": {
        "node": ">=26"
    },
    "allowScripts": {
        "dprint@0.65.0": true
    }
}
