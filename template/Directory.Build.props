<Project>
    <!--
        Holds the build settings that every project in the repository shares; MSBuild only imports the "Directory.Build.props" closest to a project,
        so "source/Directory.Build.props" and "tests/unit-tests/Directory.Build.props" import this file explicitly before adding their own output
        redirection (see Architecture)
    -->

    <!-- Continuous Integration -->
    <PropertyGroup>
        <!--
            Makes a build on the continuous integration runner deterministic in the way a published package needs it, e.g., by mapping the runner's
            local source paths to repository-relative ones in the symbol files, so that a debugger can find the sources through Source Link; it is
            only set on the runner, because it makes local debugging harder; GitHub Actions sets "GITHUB_ACTIONS" to "true" on every runner
        -->
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- Dependency Auditing -->
    <PropertyGroup>
        <!--
            Audits the transitive dependencies for known vulnerabilities as well, not only the direct ones; a vulnerable package is reported as a
            warning on every restore (see Dependency Management)
        -->
        <NuGetAuditMode>all</NuGetAuditMode>
    </PropertyGroup>
</Project>
