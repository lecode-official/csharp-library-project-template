<Project Sdk="Microsoft.NET.Sdk">
    <!-- Build Configuration -->
    <PropertyGroup>
        <TargetFramework>[[ target_framework ]]</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>[[ root_namespace ]]</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

        <!--
            Declares the library compatible with trimming and native AOT compilation, which turns on the trim, AOT, and single-file analyzers, so that
            code a consumer could not trim or compile ahead of time is reported here, instead of in the consumer's application (see Static Code
            Analysis)
        -->
        <IsAotCompatible>true</IsAotCompatible>

        <!--
            Validates the package when it is packed, e.g., that it is consistent across target frameworks; once a version has been published, set
            "PackageValidationBaselineVersion" to it, so that every later package is also checked for breaking changes against that version (see
            Versioning)
        -->
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <!-- Assembly Info -->
    <PropertyGroup>
        <AssemblyTitle>[[ product_name ]]</AssemblyTitle>
        <Product>[[ product_name ]]</Product>
        <NeutralLanguage>en-US</NeutralLanguage>
    </PropertyGroup>

    <!-- NuGet Package Information -->
    <PropertyGroup>
        <PackageId>[[ package_id ]]</PackageId>
        <Version>0.1.0</Version>
        <Title>[[ product_name ]]</Title>
        <Authors>[[ author ]]</Authors>
        <Description>[[ product_description ]]</Description>
        <Copyright>Copyright © [[ copyright_year ]] [[ copyright_holder ]]</Copyright>

        <!--
            The license is declared as an SPDX license expression, which is what NuGet expects; the "LICENSE" file at the repository root carries the
            full text of the same license (see the Contributing article); "UNLICENSED" is a NuGet extension to the SPDX syntax rather than an SPDX
            identifier itself: it packs successfully, which is what a privately distributed package needs, but nuget.org rejects it
        -->
        <PackageLicenseExpression>[[ license ]]</PackageLicenseExpression>

        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!--
            The icon nuget.org and the package managers of the editors show next to the package; NuGet only accepts a PNG or JPEG file inside the
            package, so this is the badge, baked to 128 by 128 pixels from its vector master (see Logo Design)
        -->
        <PackageIcon>package-icon.png</PackageIcon>

        <!--
            Packs the debug symbols into a separate symbol package (".snupkg") next to the package, which nuget.org serves to debuggers through its
            symbol server, so that a consumer can step into the library's code
        -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageProjectUrl>[[ repository_url ]]</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>[[ repository_url ]]</RepositoryUrl>
    </PropertyGroup>

    <!-- Packaged Files -->
    <ItemGroup>
        <!--
            "PackageReadmeFile" and "PackageIcon" above only name the files, they do not pack them; without these items, "dotnet pack" fails because a
            file it was told to use is not in the package; the icon lives with the other images in "docs/assets/images/", and "Visible" keeps it out
            of the project tree of the editor
        -->
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../../docs/assets/images/package-icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- Referenced NuGet Packages -->
    <ItemGroup>
        <!--
            Roslyn never expands <inheritdoc/> into real text in the generated XML documentation file, it is left in verbatim, so any tool reading
            that file (the API reference generator, a consumer's IDE tooltip for the compiled package, ...) sees an empty member; this task rewrites
            <inheritdoc/> into the real, inherited text as a build step, for every non-Debug build (see Documentation Website and Dependency
            Management); "PrivateAssets=all" keeps it a build-time-only dependency of this project, it is never referenced by a consumer of the
            compiled package
        -->
        <PackageReference Include="SauceControl.InheritDoc" PrivateAssets="all" />
    </ItemGroup>

    <!-- Internals Visibility -->
    <ItemGroup>
        <!--
            Grants the unit test project access to internal members, so that internal types can be unit tested directly instead of only indirectly
            through the public surface that wraps them
        -->
        <InternalsVisibleTo Include="[[ product_name ]] Unit Tests" />
    </ItemGroup>
</Project>
