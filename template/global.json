{
    // Pins the exact .NET SDK version this repository builds with; "rollForward": "disable" means an exact match is required, so a machine with a
    // different patch level fails loudly at restore time instead of silently building with another toolchain
    "sdk": {
        "version": "[[ dotnet_sdk_version ]]",
        "rollForward": "disable",

        // Shown instead of the default SDK-not-found message when the pinned version is missing
        "errorMessage": "This repository pins the .NET SDK to [[ dotnet_sdk_version ]]. Install it from https://dotnet.microsoft.com/download/dotnet/10.0 and try again.",

        // Never resolve a preview SDK, even when one is installed and is newer than the pinned version
        "allowPrerelease": false
    }
}
