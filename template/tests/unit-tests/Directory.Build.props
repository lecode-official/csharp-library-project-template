<Project>
    <!--
        Imports the repository-wide "Directory.Build.props" at the repository root first, which MSBuild would not import on its own, because it stops
        at the first "Directory.Build.props" it finds
    -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!--
        Redirects "bin/" and "obj/" out of this project's own folder and into the repository root's "build/unit-tests/" instead, keeping the source
        tree free of build output (see Architecture), the same as "source/Directory.Build.props" does for the projects under "source/"; this file
        lives directly in the project's own folder rather than needing "$([System.IO.Path]::GetFileName(...))" to derive it, since there is only the
        one project under "tests/"
    -->
    <PropertyGroup>
        <BaseOutputPath>$(MSBuildThisFileDirectory)../../build/unit-tests/bin/</BaseOutputPath>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../build/unit-tests/obj/</BaseIntermediateOutputPath>
    </PropertyGroup>
</Project>
