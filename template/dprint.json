{
    // By default, dprint only formats files that have changed since the last time it was run; setting "incremental" to false forces dprint to always
    // format all eligible files; unlike most settings, "incremental" is a global setting that cannot be inherited through "extends" (dprint reports
    // it as an unknown property when it appears in an extended configuration), so it always has to be declared in the top-level configuration
    "incremental": false,

    // By default, everything should be indented with 4 space characters and no tabs should be used (exceptions are configured accordingly)
    "indentWidth": 4,
    "useTabs": false,

    // No language should ever exceed 150 characters per line (although dprint may sometimes fail to break lines to fullfil this limit); some
    // languages, like Markdown have separate settings to disable line breaking, so the character limit does not apply to them
    "lineWidth": 150,

    // Configuration for C# files; the Roslyn plugin does not define its own option names, it reflects them straight off Microsoft's
    // "Microsoft.CodeAnalysis.CSharp.Formatting.CSharpFormattingOptions" class (the same type the Roslyn formatter itself uses), converting
    // "csharp.somePropertyName" into the "SomePropertyName" property; unknown keys are rejected with a configuration diagnostic; the plugin only
    // drives whitespace/newline/indentation (Formatter.Format), never style-analyzer preferences (there is no "csharp_style_*" or "dotnet_*" support)
    "roslyn": {
        // The line ending written to formatted files; it defaults to Carriage Return + Line Feed (CRLF), since ".gitattributes" normalizes "*.cs"
        // files to Line Feed (LF) on commit anyway, LF is used here as well to reduce friction
        "newLineKind": "lf",
    },

    // Configuration for Markdown files
    "markdown": {
        "textWrap": "never",
        "emphasisKind": "asterisks",
    },

    // Configuration for XML files
    "markup": {
        "formatComments": true,
        "preferAttrsSingleLine": true,

        // C# project files (.csproj), the shared MSBuild files (.props, .targets), and the XML-based solution files (.slnx) are XML, but they do not
        // use a file extension that the markup_fmt plugin recognizes by default, so they are explicitly associated with the plugin here; associations
        // are additive, so the plugin keeps formatting the file types it already recognizes on its own (e.g. .xml and .html)
        "associations": [
            "**/*.csproj",
            "**/*.props",
            "**/*.slnx",
            "**/*.targets",
        ],

        // The closing angle bracket is on the same line as the last attribute when a tag is broken over multiple lines
        "closingBracketSameLine": true,
    },

    // Configuration for JSON files
    "json": {
        // The JSON standard does not allow trailing commas, but the JSONC standard does, so trailing commas are forced only for JSONC; this list
        // replaces the plugin's defaults rather than extending them, so every JSONC file in the repository has to be named here; the web app manifest
        // is deliberately absent, because browsers parse it as strict JSON
        "trailingCommas": "jsonc",
        "jsonTrailingCommaFiles": [
            ".cspell.json",
            ".vscode/extensions.json",
            ".vscode/launch.json",
            ".vscode/launch.local.json",
            ".vscode/launch.shared.json",
            ".vscode/settings.json",
            ".vscode/settings.local.json",
            ".vscode/settings.shared.json",
            ".vscode/tasks.json",
            ".vscode/tasks.local.json",
            ".vscode/tasks.shared.json",
            "dprint.json",
        ],
    },

    // Configuration for YAML files
    "yaml": {
        "indentWidth": 2,
        "trimTrailingZero": true,

        // Forces a whitespace at the beginning of a comment
        "formatComments": true,

        // Wraps prose text in plain scalars when they exceed the print width
        "proseWrap": "always",
    },

    // Configuration for TOML files
    "toml": {
        "indentWidth": 2,
    },

    // Glob patterns for files that should be excluded
    "excludes": [
        // Re-includes files using the leading "!" that dprint would otherwise skip because they are ignored by Git
        "!.vscode/launch.local.json",
        "!.vscode/launch.shared.json",
        "!.vscode/settings.local.json",
        "!.vscode/settings.shared.json",
        "!.vscode/tasks.local.json",
        "!.vscode/tasks.shared.json",
        "!TODO.md",

        // Generated files: the npm and NuGet lock files, and the Copier answers file, whose contents and quoting style are written by the tool that
        // owns them rather than by hand; note that "*-lock.json" does not match "packages.lock.json", so both patterns are needed
        "**/*-lock.json",
        "**/packages.lock.json",
        ".copier-answers.yml",

        // SVGs are formatted by neither the markup nor the XML side of the toolchain without mangling their contents
        "**/*.svg",

        // The theme template override of the documentation website is a Jinja template, whose "{% %}" tags the markup plugin reads as plain text and
        // reflows into a single paragraph
        "docs/assets/templates/",

        // Build output; every project's "bin" and "obj" are redirected into "build/" (see Architecture), as is the documentation website
        "**/build/",

        // The Python virtual environment the documentation website is built in
        "**/.venv/",
    ],

    // A list of plugins that should be used by dprint
    "plugins": [
        "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.6.wasm",
        "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
        "https://plugins.dprint.dev/json-0.25.2.wasm",
        "https://plugins.dprint.dev/markdown-0.27.1.wasm",
        "https://plugins.dprint.dev/roslyn-0.23.4.wasm",
        "https://plugins.dprint.dev/toml-0.9.0.wasm",
    ],
}
